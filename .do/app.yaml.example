# Template only: confirm repository access and configure encrypted
# runtime DJANGO_SECRET_KEY and DATABASE_URL in DigitalOcean for ALL components.
# The worker is optional: add it with CELERY_BROKER_URL set on web AND worker, plus the DJANGO_EMAIL_*
# settings. Without CELERY_BROKER_URL, web sends emails itself and no worker is needed.
# The appointment-reminders job checks for day-before and 15-minute reminders every 15 minutes: give it DATABASE_URL, DJANGO_SECRET_KEY
# and the DJANGO_EMAIL_* settings too (and CELERY_BROKER_URL when a worker runs).
# Native video also needs private REDIS_URL/VIDEO_REDIS_URL, VIDEO_TURN_URLS
# and an encrypted VIDEO_TURN_SECRET on web. Provision the relay separately;
# see docs/VIDEO_CONSULTATIONS.md. Do not paste secrets into this file.
# Patient files (PathCare forms, lab reports) go to a private DigitalOcean Space once the SPACES_*
# secrets are set on web, worker and migrate; until then they are kept in the database.
# The app refuses production startup without a real secret. No deployment is
# triggered by this example file. Review region, sizing and costs in your account.
name: meridian-health
services:
  - name: web
    github:
      repo: MeridianHealthAppUser/MeridianApp
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    http_port: 8080
    health_check:
      http_path: /health/
    envs:
      - key: MULTI_PRACTICE_ENABLED
        value: 'false'
        scope: RUN_TIME
      - key: SINGLE_PRACTICE_SLUG
        value: meridian-health
        scope: RUN_TIME
      - key: DJANGO_DEBUG
        value: 'false'
        scope: RUN_TIME
      - key: DJANGO_ALLOWED_HOSTS
        value: '${APP_DOMAIN}'
        scope: RUN_TIME
      - key: DJANGO_CSRF_TRUSTED_ORIGINS
        value: '${APP_URL}'
        scope: RUN_TIME
      # Links and the logo in notification emails (docs/DEPLOYMENT.md, "Emails and appointment reminders").
      - key: DJANGO_SITE_URL
        value: '${APP_URL}'
        scope: RUN_TIME
      # Patient files in a private Space (docs/DEPLOYMENT.md, "Patient files on Spaces"). Uncomment once the
      # Space exists, on web, worker AND migrate alike, and enter the values in DigitalOcean, where they are
      # stored encrypted. Never paste them here. Without them, patient files stay in the database.
      # - key: SPACES_BUCKET
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_REGION
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_ACCESS_KEY_ID
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_SECRET_ACCESS_KEY
      #   type: SECRET
      #   scope: RUN_TIME
workers:
  # Optional. Background tasks such as emailing PathCare forms, with retries. Same image and runtime
  # settings as web; only add it together with CELERY_BROKER_URL.
  - name: worker
    github:
      repo: MeridianHealthAppUser/MeridianApp
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    run_command: celery -A config worker --loglevel=info
    envs:
      - key: MULTI_PRACTICE_ENABLED
        value: 'false'
        scope: RUN_TIME
      - key: SINGLE_PRACTICE_SLUG
        value: meridian-health
        scope: RUN_TIME
      - key: DJANGO_DEBUG
        value: 'false'
        scope: RUN_TIME
      - key: DJANGO_SITE_URL
        value: '${APP_URL}'
        scope: RUN_TIME
      # Patient files in a private Space (docs/DEPLOYMENT.md, "Patient files on Spaces"). Uncomment once the
      # Space exists, on web, worker AND migrate alike, and enter the values in DigitalOcean, where they are
      # stored encrypted. Never paste them here. Without them, patient files stay in the database.
      # - key: SPACES_BUCKET
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_REGION
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_ACCESS_KEY_ID
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_SECRET_ACCESS_KEY
      #   type: SECRET
      #   scope: RUN_TIME
jobs:
  - name: migrate
    kind: PRE_DEPLOY
    github:
      repo: MeridianHealthAppUser/MeridianApp
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    run_command: python manage.py migrate --noinput
    envs:
      - key: MULTI_PRACTICE_ENABLED
        value: 'false'
        scope: RUN_TIME
      - key: SINGLE_PRACTICE_SLUG
        value: meridian-health
        scope: RUN_TIME
      - key: DJANGO_DEBUG
        value: 'false'
        scope: RUN_TIME
      # Patient files in a private Space (docs/DEPLOYMENT.md, "Patient files on Spaces"). Uncomment once the
      # Space exists, on web, worker AND migrate alike, and enter the values in DigitalOcean, where they are
      # stored encrypted. Never paste them here. Without them, patient files stay in the database.
      # - key: SPACES_BUCKET
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_REGION
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_ACCESS_KEY_ID
      #   type: SECRET
      #   scope: RUN_TIME
      # - key: SPACES_SECRET_ACCESS_KEY
      #   type: SECRET
      #   scope: RUN_TIME
  - name: appointment-reminders
    # Emails the booked patient and clinician day-before and independent 15-minute reminders.
    # Failed 15-minute sends retry inside this invocation after 60 seconds and another 120 seconds.
    kind: SCHEDULED
    schedule:
      cron: '*/15 * * * *'
      time_zone: Africa/Johannesburg
    github:
      repo: MeridianHealthAppUser/MeridianApp
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    run_command: python manage.py send_appointment_reminders
    envs:
      - key: MULTI_PRACTICE_ENABLED
        value: 'false'
        scope: RUN_TIME
      - key: SINGLE_PRACTICE_SLUG
        value: meridian-health
        scope: RUN_TIME
      - key: DJANGO_DEBUG
        value: 'false'
        scope: RUN_TIME
      - key: DJANGO_SITE_URL
        value: '${APP_URL}'
        scope: RUN_TIME
  - name: daily-debits
    # Collects the subscription debits that have come round and retries failed ones on their retry days
    # (care/billing.py). Needs the same runtime settings as web, including PAYMENT_PROVIDER and its keys.
    kind: SCHEDULED
    schedule:
      cron: '0 6 * * *'
      time_zone: Africa/Johannesburg
    github:
      repo: MeridianHealthAppUser/MeridianApp
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    run_command: python manage.py run_debits
    envs:
      - key: MULTI_PRACTICE_ENABLED
        value: 'false'
        scope: RUN_TIME
      - key: SINGLE_PRACTICE_SLUG
        value: meridian-health
        scope: RUN_TIME
      - key: DJANGO_DEBUG
        value: 'false'
        scope: RUN_TIME
      - key: DJANGO_SITE_URL
        value: '${APP_URL}'
        scope: RUN_TIME
      # - key: PAYMENT_PROVIDER
      #   value: peach
      #   scope: RUN_TIME
  - name: journey-emails
    # Sends the email journeys' emails that are due (care/journeys.py), once a day.
    kind: SCHEDULED
    schedule:
      cron: '0 9 * * *'
      time_zone: Africa/Johannesburg
    github:
      repo: MeridianHealthAppUser/MeridianApp
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    run_command: python manage.py send_journey_emails
    envs:
      - key: MULTI_PRACTICE_ENABLED
        value: 'false'
        scope: RUN_TIME
      - key: SINGLE_PRACTICE_SLUG
        value: meridian-health
        scope: RUN_TIME
      - key: DJANGO_DEBUG
        value: 'false'
        scope: RUN_TIME
      - key: DJANGO_SITE_URL
        value: '${APP_URL}'
        scope: RUN_TIME
