DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com,.ondigitalocean.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://your-app.ondigitalocean.app
DJANGO_SECURE_HSTS_SECONDS=31536000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DJANGO_TIME_ZONE=Africa/Johannesburg

# Only Meridian Health is available. This is also the default when unset.
# Do not enable multiple practices unless deliberately restoring that capability.
MULTI_PRACTICE_ENABLED=false
SINGLE_PRACTICE_SLUG=meridian-health

# Discount code that settles the initial consultation at R0 for testing the
# full patient conversion. Off when empty; never set it for real patients.
CHECKOUT_TEST_CODE=

# Native video: Redis is required outside single-process local development.
VIDEO_ENABLED=true
REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:REDIS_PORT/0
# Optional separate Redis for signalling/presence; otherwise uses REDIS_URL.
# VIDEO_REDIS_URL=
VIDEO_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Configure a coturn-compatible relay with a private shared secret (32+ chars).
VIDEO_TURN_URLS=
VIDEO_TURN_SECRET=
VIDEO_TURN_CREDENTIAL_TTL=3600
# all = direct media with relay fallback; relay = only configured TURN relay.
VIDEO_ICE_TRANSPORT_POLICY=all

# Outgoing email for password reset links and PathCare forms (Brevo SMTP relay). Leave DJANGO_EMAIL_HOST
# empty to send no email: the Forgot password page then points people to support, and PathCare forms
# stay in the clinical log marked not emailed, ready to resend once email is set up.
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_HOST_USER=your-brevo-smtp-login
DJANGO_EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DJANGO_DEFAULT_FROM_EMAIL=Meridian Health <no-reply@meridianhealth.co.za>

# Optional background tasks (Celery), such as emailing PathCare blood-test forms. Set a broker (it can be
# the same Redis as REDIS_URL) only once a worker component is running; it then sends them and retries
# failures. Left empty, tasks run straight away in the web process.
CELERY_BROKER_URL=

# Patient files (PathCare forms and uploaded lab reports) in a private DigitalOcean Space. Set all four
# SPACES_* values below or none of them. Without them, production keeps these files in the database;
# after setting them, run `python manage.py move_patient_files_to_spaces` once. See docs/DEPLOYMENT.md.
# SPACES_BUCKET=your-private-space-name
# SPACES_REGION=fra1
# SPACES_ACCESS_KEY_ID=your-spaces-access-key-id
# SPACES_SECRET_ACCESS_KEY=your-spaces-secret-key
# Optional: the folder the files go under in the Space (default meridian-health).
# SPACES_PREFIX=meridian-health
